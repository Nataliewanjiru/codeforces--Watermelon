import sys

def solve():
    n = int(sys.stdin.readline())
    a = list(map(int, sys.stdin.readline().split()))
    
    has_odd = False
    has_even = False
    
    for x in a:
        if x % 2 == 0:
            has_even = True
        else:
            has_odd = True
            
    if has_odd and has_even:
        a.sort()
        
    print(*(a))

solve()
